{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskBridge",
  "version": "0.1.0",
  "identifier": "local.deskbridge.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DeskBridge",
        "width": 920,
        "height": 680,
        "minWidth": 760,
        "minHeight": 580,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "target/generated/deskbridge.png",
      "target/generated/deskbridge.ico"
    ]
  }
}
